# Wildwood Academy Environment Configuration

# 1. Supabase Backend (PostgreSQL, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. AI Intelligence Providers (At least one recommended for live AI generation)
# Google Gemini API key (recommended: gemini-1.5-pro or gemini-1.5-flash)
GEMINI_API_KEY=
# Or OpenAI API key (gpt-4o-mini / gpt-4o)
OPENAI_API_KEY=

# 3. Application Security & Session Secret
APP_SESSION_SECRET=wildwood-enchanted-secret-salt-key-replace-in-production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. Storage mode ('supabase' or 'local' file-system fallback)
STORAGE_MODE=auto
